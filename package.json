{
  "name": "@jelto/analytics",
  "version": "1.0.2",
  "description": "Typed browser tracker and scoped server API for Jelto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usejelto/javascript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/usejelto/javascript-sdk/issues"
  },
  "homepage": "https://jelto.io/docs/sdk/analytics",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": "./dist/server.browser.js",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "preconformance": "npm run build",
    "conformance": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
